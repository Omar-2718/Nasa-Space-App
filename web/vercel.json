{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "${API_URL}/api/$1" },
    { "source": "/patches/(.*)", "destination": "${API_URL}/patches/$1" },
    { "source": "/layers/(.*)", "destination": "${API_URL}/layers/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
